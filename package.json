{
  "name": "wrestling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "ratings:calculate": "node --env-file-if-exists=.env.local --import tsx scripts/ratings/calculate.ts",
    "ratings:backtest": "node --env-file-if-exists=.env.local --import tsx scripts/ratings/backtest.ts",
    "matches:prepare": "node --import tsx scripts/imports/prepare-matches.ts",
    "identity:audit": "node --import tsx scripts/identity/audit.ts",
    "release:run": "node --import tsx scripts/release/run.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postgres": "3.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
